# Runtime
APP_ENV=development
APP_URL=http://localhost
PHONE_DEFAULT_COUNTRY=52

# Security / audit
# Optional: defaults to the system temp directory when omitted.
RATE_LIMIT_DIR=/var/lib/solution-spa/rate-limits
# Audit events are minimized and pruned automatically; accepted range: 30-3650 days.
AUDIT_RETENTION_DAYS=180

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=solution_spa
DB_USER=solution_spa
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

# Deployment scripts (server only; do not commit real values)
APP_DIR=/var/www/solution-spa
BACKUP_DIR=/var/backups/solution-spa
DEPLOY_BRANCH=main
